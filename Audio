import numpy as np
import sounddevice as sd
from pynput import keyboard

sample_rate = 44100
volumen = 0.4

# Frecuencias
notas = {
    'a': 261.63,  # Do
    's': 293.66,  # Re
    'd': 329.63,  # Mi
    'f': 349.23,  # Fa
    'g': 392.00,  # Sol
    'h': 440.00,  # La
    'j': 493.88,  # Si
    'k': 523.25   # Do agudo
}

# Paneo estéreo
# -1 = izquierda total
#  0 = centro
#  1 = derecha total
paneo = {
    'a': -1.0,
    's': -0.7,
    'd': -0.4,
    'f': -0.1,
    'g': 0.1,
    'h': 0.4,
    'j': 0.7,
    'k': 1.0
}

teclas_activas = set()
fase = 0

def audio_callback(outdata, frames, time, status):
    global fase

    t = (np.arange(frames) + fase) / sample_rate

    left = np.zeros(frames)
    right = np.zeros(frames)

    for tecla in teclas_activas:
        frecuencia = notas[tecla]

        onda = np.sin(2 * np.pi * frecuencia * t)

        pan = paneo[tecla]

        # Conversión de paneo
        left_gain = (1 - pan) / 2
        right_gain = (1 + pan) / 2

        left += onda * left_gain
        right += onda * right_gain

    if len(teclas_activas) > 0:
        left /= len(teclas_activas)
        right /= len(teclas_activas)

    stereo = np.column_stack((left, right))

    outdata[:] = stereo * volumen

    fase += frames

def on_press(key):
    try:
        tecla = key.char.lower()

        if tecla in notas:
            teclas_activas.add(tecla)

    except:
        pass

def on_release(key):
    try:
        tecla = key.char.lower()

        teclas_activas.discard(tecla)

    except:
        pass

    if key == keyboard.Key.esc:
        return False

print("Piano estéreo activo")
print("A S D F G H J K")
print("ESC para salir")

with sd.OutputStream(
    channels=2,
    callback=audio_callback,
    samplerate=sample_rate
):
    with keyboard.Listener(
        on_press=on_press,
        on_release=on_release
    ) as listener:

        listener.join()